{
  "name": "astro-test",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm-run-all --parallel dev:db dev:server",
    "build": "astro check && astro build --remote",
    "preview": "npm-run-all --parallel dev:db dev:preview",
    "test:unit": "vitest --no-file-parallelism --exclude \"src/tests/e2e/**\"",
    "test:e2e": "NODE_NO_WARNINGS=1 npx playwright test",
    "dev:db": "turso dev --db-file dev.db",
    "dev:server": "astro dev --host",
    "dev:preview": "astro build && wrangler pages dev --port 4321",
    "cf-typegen": "wrangler types",
    "db:push": "drizzle-kit push",
    "db:push:prod": "NODE_ENV=production drizzle-kit push",
    "db:push:test": "NODE_ENV=test drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "NODE_ENV=production drizzle-kit studio",
    "db:studio:test": "NODE_ENV=test drizzle-kit studio",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:seed:test": "NODE_ENV=test tsx src/db/seed.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/react": "^6.0.2",
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "^3.0.3",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/radio-canada": "^5.3.0",
    "@fontsource-variable/reddit-sans": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@libsql/client": "^0.17.4",
    "@nivo/pie": "^0.95.0",
    "@node-rs/argon2": "^1.8.3",
    "@playwright/test": "^1.62.1",
    "@radix-ui/themes": "^3.3.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/router-plugin": "^1.168.32",
    "@tanstack/virtual-core": "^3.10.4",
    "@types/chroma-js": "^3.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "arctic": "^3.7.0",
    "astro": "^7.2.2",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv": "^6.6.3",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.3",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.40.1",
    "drizzle-zod": "^0.7.1",
    "immer": "^10.2.0",
    "jotai": "^2.20.2",
    "lucide-react": "^1.31.0",
    "postcss-import": "^16.2.0",
    "radix-themes-tw": "^0.2.3",
    "react": "^18.3.1",
    "react-cookie": "^7.2.2",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^2.1.9",
    "sharp": "^0.33.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tiny-invariant": "^1.3.3",
    "typescript": "^5.9.3",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "vitest": "^3.2.7"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.167.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.12",
    "wrangler": "^4.1.0"
  }
}
